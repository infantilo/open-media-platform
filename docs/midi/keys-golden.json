          "mute": false,
          "pfl": false,
          "proc": {
            "eqBypass": false
          }
        },
        {
          "id": "b",
          "label": "B",
          "gainDb": 0,
          "mute": false,
          "pfl": false,
          "proc": {
            "eqBypass": false
