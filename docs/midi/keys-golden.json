        {
          "do": "press",
          "key": "f1",
          "expect": [
            {
              "c": "call",
              "node": "",
              "method": "channel.b.setMute",
              "args": {
                "muted": false
              }
            }
          ],
          "state": {
            "leds": {
              "f1": "off"
            }
          }
        },
        {
          "do": "press",
          "key": "f4",
          "expect": [
            {
              "c": "call",
              "node": "",
