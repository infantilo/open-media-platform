{
  "$schema": "https://ograf.ebu.io/v1/specification/json-schemas/graphics/schema.json",
  "id": "scoreboard",
  "version": "1.0.0",
  "name": "Ergebnis-Tafel (Sport)",
  "description": "Spielstand oben links: zwei Teams, Tore, Spielzeit/Abschnitt.",
  "author": {
    "name": "OpenMediaPlatform"
  },
  "main": "scoreboard.js",
  "supportsRealTime": true,
  "supportsNonRealTime": false,
  "stepCount": 1,
  "schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "teamA": {
        "type": "string",
        "title": "Team A",
        "default": "HEIM"
      },
      "teamB": {
        "type": "string",
        "title": "Team B",
        "default": "GAST"
      },
      "scoreA": {
        "type": "integer",
        "title": "Tore A",
        "default": 0,
        "minimum": 0,
        "maximum": 999
      },
      "scoreB": {
        "type": "integer",
        "title": "Tore B",
        "default": 0,
        "minimum": 0,
        "maximum": 999
      },
      "time": {
        "type": "string",
        "title": "Spielzeit",
        "default": "00:00"
      },
      "period": {
        "type": "string",
        "title": "Abschnitt",
        "default": "1. HZ"
      },
      "colorA": {
        "type": "string",
        "title": "Farbe A",
        "default": "#0b5ed7",
        "gddType": "color-rrggbb",
        "pattern": "^#[0-9a-f]{6}$"
      },
      "colorB": {
        "type": "string",
        "title": "Farbe B",
        "default": "#d90012",
        "gddType": "color-rrggbb",
        "pattern": "^#[0-9a-f]{6}$"
      },
      "bgColor": {
        "type": "string",
        "title": "Hintergrund",
        "default": "#101826",
        "gddType": "color-rrggbb",
        "pattern": "^#[0-9a-f]{6}$"
      },
      "textColor": {
        "type": "string",
        "title": "Textfarbe",
        "default": "#ffffff",
        "gddType": "color-rrggbb",
        "pattern": "^#[0-9a-f]{6}$"
      }
    }
  },
  "renderRequirements": [
    {
      "resolution": {
        "width": {
          "ideal": 1920
        },
        "height": {
          "ideal": 1080
        }
      },
      "frameRate": {
        "ideal": 25
      }
    }
  ]
}
