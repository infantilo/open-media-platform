{
  "$schema": "https://ograf.ebu.io/v1/specification/json-schemas/graphics/schema.json",
  "id": "omp-wipe-divider",
  "version": "1.0.0",
  "name": "OMP_Trenner Wipe (rot)",
  "description": "Übergang zwischen Playlist-Events: roter Verlaufsbalken links von oben nach unten, rechts von unten nach oben. Bei 50 % der Dauer ist das Bild voll verdeckt (hier den Event-Wechsel legen), danach geben die Balken das neue Bild frei. Beendet sich selbst. Als Child Event: Start = Wechselzeitpunkt − Dauer/2, Dauer des Child Events = Dauer der Vorlage.",
  "author": {
    "name": "OpenMediaPlatform"
  },
  "main": "omp-wipe-divider.js",
  "supportsRealTime": true,
  "supportsNonRealTime": false,
  "stepCount": 1,
  "schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "duration": {
        "type": "integer",
        "title": "Gesamtdauer (ms), Schnitt bei der Hälfte",
        "default": 1800,
        "minimum": 200,
        "maximum": 10000
      },
      "color": {
        "type": "string",
        "title": "Farbe",
        "default": "#d90012",
        "gddType": "color-rrggbb",
        "pattern": "^#[0-9a-f]{6}$"
      },
      "softness": {
        "type": "integer",
        "title": "Weiche Kante (% der Bildhöhe)",
        "default": 30,
        "minimum": 0,
        "maximum": 100
      },
      "hold": {
        "type": "integer",
        "title": "Volle Deckung (% der Bildhöhe, Schnitt-Toleranz)",
        "default": 30,
        "minimum": 0,
        "maximum": 200
      },
      "reverse": {
        "type": "boolean",
        "title": "Richtung umkehren",
        "default": false
      }
    }
  },
  "renderRequirements": [
    {
      "resolution": {
        "width": {
          "ideal": 1920
        },
        "height": {
          "ideal": 1080
        }
      },
      "frameRate": {
        "ideal": 25
      }
    }
  ]
}
