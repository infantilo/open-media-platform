{
  "$schema": "https://ograf.ebu.io/v1/specification/json-schemas/graphics/schema.json",
  "id": "title-card",
  "version": "1.0.0",
  "name": "Titelkarte (Vollbild)",
  "description": "Vollbild-Titel mit Untertitel auf farbigem Grund, z. B. Sendungsbeginn, Pausenkarte, Bumper. Blendet weich ein/aus.",
  "author": {
    "name": "OpenMediaPlatform"
  },
  "main": "title-card.js",
  "supportsRealTime": true,
  "supportsNonRealTime": false,
  "stepCount": 1,
  "schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "title": {
        "type": "string",
        "title": "Titel",
        "default": "Titel"
      },
      "subtitle": {
        "type": "string",
        "title": "Untertitel",
        "default": ""
      },
      "bgColor": {
        "type": "string",
        "title": "Hintergrund",
        "default": "#0b1020",
        "gddType": "color-rrggbb",
        "pattern": "^#[0-9a-f]{6}$"
      },
      "accentColor": {
        "type": "string",
        "title": "Akzentfarbe",
        "default": "#d90012",
        "gddType": "color-rrggbb",
        "pattern": "^#[0-9a-f]{6}$"
      },
      "textColor": {
        "type": "string",
        "title": "Textfarbe",
        "default": "#ffffff",
        "gddType": "color-rrggbb",
        "pattern": "^#[0-9a-f]{6}$"
      }
    }
  },
  "renderRequirements": [
    {
      "resolution": {
        "width": {
          "ideal": 1920
        },
        "height": {
          "ideal": 1080
        }
      },
      "frameRate": {
        "ideal": 25
      }
    }
  ]
}
