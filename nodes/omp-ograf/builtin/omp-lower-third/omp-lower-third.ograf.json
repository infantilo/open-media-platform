{
  "$schema": "https://ograf.ebu.io/v1/specification/json-schemas/graphics/schema.json",
  "id": "omp-lower-third",
  "version": "1.0.0",
  "name": "OMP_Bauchbinde (Name + Funktion)",
  "description": "Klassische Bauchbinde unten links: Name und Funktion/Ort, schiebt von links ein.",
  "author": {
    "name": "OpenMediaPlatform"
  },
  "main": "omp-lower-third.js",
  "supportsRealTime": true,
  "supportsNonRealTime": false,
  "stepCount": 1,
  "schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "name": {
        "type": "string",
        "title": "Name",
        "default": "Name Nachname"
      },
      "role": {
        "type": "string",
        "title": "Funktion / Ort",
        "default": "Funktion"
      },
      "accentColor": {
        "type": "string",
        "title": "Akzentfarbe",
        "default": "#d90012",
        "gddType": "color-rrggbb",
        "pattern": "^#[0-9a-f]{6}$"
      },
      "bgColor": {
        "type": "string",
        "title": "Hintergrund",
        "default": "#101826",
        "gddType": "color-rrggbb",
        "pattern": "^#[0-9a-f]{6}$"
      },
      "textColor": {
        "type": "string",
        "title": "Textfarbe",
        "default": "#ffffff",
        "gddType": "color-rrggbb",
        "pattern": "^#[0-9a-f]{6}$"
      }
    }
  },
  "renderRequirements": [
    {
      "resolution": {
        "width": {
          "ideal": 1920
        },
        "height": {
          "ideal": 1080
        }
      },
      "frameRate": {
        "ideal": 25
      }
    }
  ]
}
