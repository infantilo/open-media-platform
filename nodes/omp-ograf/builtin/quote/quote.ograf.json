{
  "$schema": "https://ograf.ebu.io/v1/specification/json-schemas/graphics/schema.json",
  "id": "quote",
  "version": "1.0.0",
  "name": "Zitat",
  "description": "Zitat mit Urheber im unteren Drittel auf halbtransparentem Grund.",
  "author": {
    "name": "OpenMediaPlatform"
  },
  "main": "quote.js",
  "supportsRealTime": true,
  "supportsNonRealTime": false,
  "stepCount": 1,
  "schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "text": {
        "type": "string",
        "title": "Zitat",
        "default": "„Zitat.“"
      },
      "author": {
        "type": "string",
        "title": "Urheber",
        "default": ""
      },
      "accentColor": {
        "type": "string",
        "title": "Akzentfarbe",
        "default": "#d90012",
        "gddType": "color-rrggbb",
        "pattern": "^#[0-9a-f]{6}$"
      },
      "bgColor": {
        "type": "string",
        "title": "Hintergrund",
        "default": "#101826",
        "gddType": "color-rrggbb",
        "pattern": "^#[0-9a-f]{6}$"
      },
      "textColor": {
        "type": "string",
        "title": "Textfarbe",
        "default": "#ffffff",
        "gddType": "color-rrggbb",
        "pattern": "^#[0-9a-f]{6}$"
      }
    }
  },
  "renderRequirements": [
    {
      "resolution": {
        "width": {
          "ideal": 1920
        },
        "height": {
          "ideal": 1080
        }
      },
      "frameRate": {
        "ideal": 25
      }
    }
  ]
}
