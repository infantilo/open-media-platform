# Beispiel für deploy/dev/cloud.env — kopieren, ausfüllen, `chmod 600 deploy/dev/cloud.env`.
# `make start` liest die Datei, wenn sie existiert (sie steht in der .gitignore und wird NIE committet).
# Ohne die Datei sind alle Cloud-Funktionen aus. Erklärung aller Variablen: docs/CLOUD-AWS.md.
# Werte mit Sonderzeichen (JSON!) in einfache Anführungszeichen setzen.

# --- Zum Ausprobieren ohne Konto und ohne Kosten: reine Simulation ---------------------------------------------
# OMP_CLOUD_PROVIDER=mock

# --- AWS ---------------------------------------------------------------------------------------------------------
# OMP_CLOUD_PROVIDER=aws
# OMP_CLOUD_AWS_REGION=eu-central-1
# AWS_ACCESS_KEY_ID=AKIA...................
# AWS_SECRET_ACCESS_KEY=........................................
# AWS_SESSION_TOKEN=                      # nur bei temporären Zugangsdaten
# OMP_CLOUD_AWS_AMI=ami-0123456789abcdef0 # Image mit installiertem omp-host-agent
# OMP_CLOUD_AWS_SUBNET=subnet-0123456789abcdef0
# OMP_CLOUD_AWS_SECURITY_GROUPS=sg-0123456789abcdef0
# OMP_CLOUD_AWS_KEY_NAME=
# OMP_CLOUD_POOLS='[{"name":"burst","region":"eu-central-1","instanceType":"t3.medium","min":0,"max":2,"idleAfterSec":300,"maxLifetimeSec":43200}]'
# OMP_CLOUD_USERDATA_FILE=deploy/cloud/userdata-example.sh
# OMP_CLOUD_DEPLOYMENT=omp

# Echte Starts (kostet Geld!) erst freigeben, wenn der Trockenlauf geprüft ist. Ohne diese Zeile startet nichts.
# OMP_CLOUD_AWS_ALLOW_LAUNCH=1
