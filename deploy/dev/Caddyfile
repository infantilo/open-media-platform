# Lokaler Reverse-Proxy mit TLS-Terminierung für OMP (S7,
# docs/REVIEW-2026-07-17-SKALIERUNG-24-7.md: "Remote-Zugriff dokumentiert
# absichern" — Bearer-Token + ?access_token= setzen HTTPS voraus, s.
# docs/HANDBUCH.md Abschnitt 6). Der Orchestrator selbst bleibt dahinter
# Klartext-HTTP — kein TLS-Handling/keine Zertifikatsverwaltung im
# Go-Code, das ist bewusst Aufgabe des Proxys, nicht des Orchestrators
# (ARCHITECTURE.md §4.6 trifft dieselbe Trennung schon für mTLS
# Orchestrator↔Nodes).
#
# "tls internal" lässt Caddy sein eigenes lokales CA-Zertifikat
# erzeugen/verwalten — kein manueller Zertifikats-Schritt für den
# Dev-Betrieb (für echten Fernzugriff über das Internet stattdessen
# eine öffentliche Domain + Caddys automatisches Let's-Encrypt-TLS
# nutzen, s. docs/HANDBUCH.md).
#
# "auto_https disable_redirects": Caddy versucht sonst zusätzlich zu
# :8443 automatisch einen HTTP→HTTPS-Redirect-Listener auf Port 80 zu
# öffnen — im rootless-Podman-Container ohne CAP_NET_BIND_SERVICE
# schlägt das mit "permission denied" fehl und der ganze Prozess
# startet nicht (per Live-Test gefunden). Nur der Redirect-Listener
# entfällt, automatisches TLS-Zertifikat-Management für :8443 bleibt
# unverändert aktiv.
{
	auto_https disable_redirects
}

localhost:8443 {
	tls internal

	# SSE (GET /api/v1/events, sse.Hub) darf nicht gepuffert werden —
	# ohne flush_interval -1 hält Caddy einzelne Chunks ggf. zurück, bis
	# ein interner Puffer voll ist, was Live-Updates (Status-Änderungen,
	# Tally, Alarme, …) im Browser spürbar verzögert.
	reverse_proxy 127.0.0.1:8000 {
		flush_interval -1
	}
}

# Smartphone-Kamera (omp-webrtc-gateway, Nachtrag 242): `getUserMedia` läuft
# im Handy-Browser nur über HTTPS. Feste Node-Portnummer 9440 (OMP_PORT beim
# Start des Gateways setzen — der Launcher vergibt sonst dynamische Ports,
# die ein statischer Proxy nicht kennen kann). Hostname/IP, unter der das
# Handy den Rechner erreicht, per OMP_PUBLIC_HOST (Default localhost; im LAN
# die IP oder den mDNS-Namen, sonst passt der SAN des internen Zertifikats
# nicht). Das Handy muss die Caddy-Root-CA akzeptieren:
# .run/caddy/pki/authorities/local/root.crt (s. docs/HANDBUCH.md).
# Auch unter localhost/penguin.linux.test/127.0.0.1 erreichbar (ChromeOS
# leitet Container-Ports auf localhost weiter): Caddy antwortet bei einem
# NICHT konfigurierten Hostnamen sonst mit leerem 200 (weiße Seite).
{$OMP_PUBLIC_HOST:localhost}:9441, localhost:9441, penguin.linux.test:9441, 127.0.0.1:9441 {
	tls internal
	reverse_proxy 127.0.0.1:9440 {
		flush_interval -1
	}
	# Ohne laufenden Node liefert Caddy sonst einen LEEREN 502 (weiße Seite).
	handle_errors {
		header Content-Type "text/plain; charset=utf-8"
		respond "Kamera-Node nicht erreichbar (Port 9440). Starten mit: OMP_PUBLIC_HOST=<IP> deploy/dev/start-webrtc-phone.sh" 503
	}
}

# Smartphone-Monitor (omp-webrtc-gateway mit OMP_WEBRTC_GATEWAY_DIRECTION=monitor,
# Nachtrag 243): Node fest auf OMP_PORT=9442, HTTPS auf 9443. Gleiche
# Hinweise wie beim Kamera-Block oben (OMP_PUBLIC_HOST, Root-CA am Handy).
# Auch unter localhost/penguin.linux.test/127.0.0.1 erreichbar (ChromeOS
# leitet Container-Ports auf localhost weiter): Caddy antwortet bei einem
# NICHT konfigurierten Hostnamen sonst mit leerem 200 (weiße Seite).
{$OMP_PUBLIC_HOST:localhost}:9443, localhost:9443, penguin.linux.test:9443, 127.0.0.1:9443 {
	tls internal
	reverse_proxy 127.0.0.1:9442 {
		flush_interval -1
	}
	# Ohne laufenden Node liefert Caddy sonst einen LEEREN 502 (weiße Seite).
	handle_errors {
		header Content-Type "text/plain; charset=utf-8"
		respond "Monitor-Node nicht erreichbar (Port 9442). Starten mit: OMP_PUBLIC_HOST=<IP> deploy/dev/start-webrtc-phone.sh" 503
	}
}
