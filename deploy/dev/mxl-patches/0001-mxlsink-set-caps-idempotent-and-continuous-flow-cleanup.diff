+/// Process-wide lock serializing every MXL domain-mutating operation across
+/// ALL `mxlsink` instances in this process (`Instance::garbage_collect_flows`
+/// AND `Instance::create_flow_writer`, both below and in `imp.rs::start`).
+///
+/// Root cause (found live, not assumed): a pipeline with two `mxlsink`
+/// elements writing to the SAME domain under DIFFERENT flow-ids (e.g. a
+/// video+audio branch pair, PIPELINE CONTROLLER's `mxl` output type,
+/// `deploy/pipeline-controller/patches/0001-mxl-output.diff`) intermittently
+/// failed with "the UUID belongs to a flow with another active writer" on
+/// ONE of the two branches — reproducible under heavy concurrent pipeline
+/// construction (many other pipelines starting at the same time), never
+/// reproducible in an isolated two-element pipeline. `Instance::_mutex`
+/// (`lib/internal/src/Instance.cpp`, `createFlowWriter`) only serializes
+/// calls against the SAME `Instance` — each `mxlsink` element owns its OWN
+/// `MxlInstance` (`init_mxl_instance`, `imp.rs`), so two SIBLING elements'
+/// `garbage_collect_flows()`/`create_flow_writer()` calls are NOT
+/// synchronized against each other by that mutex. `garbage_collect_flows()`
+/// scans the WHOLE domain directory and reclaims any `*.mxl-flow` whose
+/// data file is not currently flock'd — if it runs (from one sibling's
+/// `start()`) in the narrow window between another sibling's flow directory
+/// being created and its flock being acquired (`create_flow_writer()`), the
+/// not-yet-locked, freshly-created flow looks orphaned and the two race.
+/// Fix: never let a GC pass and a flow-writer creation from this process
+/// overlap, regardless of which `MxlInstance`/UUID is involved — a single
+/// process-wide lock is sufficient (MXL flow creation/GC is not a
+/// steady-state hot path, only happens once per element start, so the
+/// serialization cost is negligible).
+static DOMAIN_LOCK: LazyLock<Mutex<()>> = LazyLock::new(|| Mutex::new(()));
+
+/// RAII-Guard-Handle für `DOMAIN_LOCK` — `imp.rs` braucht ihn für
+/// `garbage_collect_flows()`, dieses Modul für `create_flow_writer()`.
+pub(crate) fn lock_domain_ops() -> std::sync::MutexGuard<'static, ()> {
+    DOMAIN_LOCK.lock().unwrap_or_else(|poisoned| poisoned.into_inner())
+}
