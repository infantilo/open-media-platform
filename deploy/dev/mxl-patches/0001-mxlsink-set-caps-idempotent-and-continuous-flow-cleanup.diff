+/// OMP-Patch (Nachtrag 116, erneut Nachtrag 227 gegen v1.1.0 portiert):
+/// Prozessweiter Lock, der JEDE domain-verändernde MXL-Operation über ALLE
+/// `mxlsink`-Instanzen dieses Prozesses serialisiert
+/// (`Instance::garbage_collect_flows` in `imp.rs` UND
+/// `Instance::create_flow_writer` unten).
+///
+/// Root Cause (live gefunden, nicht angenommen): eine Pipeline mit zwei
+/// `mxlsink`-Elementen, die in DIESELBE Domain unter VERSCHIEDENEN
+/// Flow-IDs schreiben (z. B. ein Video+Audio-Zweigpaar, PIPELINE
+/// CONTROLLERs `mxl`-Ausgangstyp), scheiterte intermittierend mit "the
+/// UUID belongs to a flow with another active writer" auf EINEM der
+/// beiden Zweige — reproduzierbar unter starker gleichzeitiger
+/// Pipeline-Aufbaulast, nie in einer isolierten Zwei-Element-Pipeline.
+/// `Instance::_mutex` (`lib/internal/src/Instance.cpp`,
+/// `createFlowWriter`) serialisiert nur Aufrufe gegen DIESELBE
+/// `Instance` — jedes `mxlsink`-Element besitzt seine EIGENE
+/// `MxlInstance` (`init_mxl_instance`, `imp.rs`), zwei GESCHWISTER-
+/// Elemente sind über diesen Mutex also NICHT gegeneinander
+/// synchronisiert. `garbage_collect_flows()` scannt das GESAMTE
+/// Domain-Verzeichnis und reklamiert jedes `*.mxl-flow`, dessen
+/// Datendatei gerade nicht geflockt ist — läuft es (aus dem `start()`
+/// eines Geschwisters) im schmalen Fenster zwischen dem Anlegen des
+/// Flow-Verzeichnisses eines anderen Geschwisters und dessen
+/// Flock-Erwerb (`create_flow_writer()`), sieht der noch ungeflockte,
+/// frisch angelegte Flow verwaist aus, und beide laufen sich in die
+/// Quere. Fix: eine GC-Runde und eine Flow-Writer-Erstellung aus diesem
+/// Prozess dürfen sich nie überlappen, unabhängig davon, welche
+/// `MxlInstance`/UUID beteiligt ist — ein einzelner prozessweiter Lock
+/// reicht (Flow-Anlage/GC ist kein Hot-Path, passiert nur einmal pro
+/// Element-Start, die Serialisierungskosten sind vernachlässigbar).
+///
+/// **Bewusst NICHT mehr Teil dieses Patches (anders als Nachtrag 116):**
+/// die frühere `set_caps`-Idempotenz-Ergänzung — v1.1.0 implementiert das
+/// jetzt selbst, korrekter sogar (vergleicht `flow_def` statt jeden
+/// Re-Aufruf blind als No-Op zu behandeln, s. `RE_SET_CAPS_NO_CHANGE`
+/// unten in `init_state_with_video`/`init_state_with_audio`).
+static DOMAIN_LOCK: LazyLock<Mutex<()>> = LazyLock::new(|| Mutex::new(()));
+
+/// RAII-Guard-Handle für `DOMAIN_LOCK` — `imp.rs` braucht ihn für
+/// `garbage_collect_flows()`, dieses Modul für `create_flow_writer()`.
+pub(crate) fn lock_domain_ops() -> std::sync::MutexGuard<'static, ()> {
+    DOMAIN_LOCK.lock().unwrap_or_else(|poisoned| poisoned.into_inner())
+}
