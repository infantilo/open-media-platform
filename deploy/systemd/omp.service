# systemd-Dienst für den OMP-Hauptrechner (Orchestrator, Supervisor, NATS, Registry,
# Postgres/etcd — alles, was `make start` startet). Rootless-Podman braucht dafür
# ein Benutzer-Runtime-Verzeichnis:  sudo loginctl enable-linger <benutzer>
# Installation: ./install.sh --systemd  (ersetzt @USER@/@ROOT@/@UID@/@HOME@ und aktiviert den Dienst)
# Von Hand (als root), Platzhalter @…@ ersetzen:
#   sudo cp deploy/systemd/omp.service /etc/systemd/system/
#   sudo loginctl enable-linger adunkl
#   sudo systemctl daemon-reload && sudo systemctl enable --now omp
# Der Dienst ruft start-omp.sh / stop-omp.sh auf (OHNE --all: Container und
# Postgres-Daten bleiben beim Stoppen unangetastet, nur der Orchestrator endet).
[Unit]
StartLimitIntervalSec=0
Description=OpenMediaPlatform (Orchestrator + Infrastruktur)
After=network-online.target
Wants=network-online.target

[Service]
# Uhr (Audit M1): Host-Agent/Orchestrator setzen TAI-Versatz und stellen die Uhr selbst, wenn kein Zeitdienst (chrony) läuft. Das braucht CAP_SYS_TIME.
# Bevorzugt nur für die Programmdatei: sudo setcap cap_sys_time+ep @ROOT@/bin/omp-orchestrator  (nach jedem Neubau wiederholen). AmbientCapabilities=CAP_SYS_TIME
# würde auch an alle Nodes vererbt. Abschalten: OMP_CLOCK_DISCIPLINE=off; Server: OMP_CLOCK_NTP_SERVERS (Standard pool.ntp.org).
Type=oneshot
RemainAfterExit=yes
User=@USER@
# Härtung/Limits (Audit M11) — nur, was den Medienbetrieb und rootless Podman nicht berührt. Bewusst NICHT gesetzt: ProtectSystem/ProtectHome/PrivateTmp
# (Nodes schreiben unter @ROOT@ und /dev/shm/omp-mxl), ProtectControlGroups/RestrictSUIDSGID (rootless Podman), NoNewPrivileges (setcap für CAP_SYS_TIME).
ProtectKernelModules=yes
ProtectKernelLogs=yes
LockPersonality=yes
SystemCallArchitectures=native
LimitNOFILE=65536
LimitMEMLOCK=infinity
TasksMax=infinity
WorkingDirectory=@ROOT@
Environment=XDG_RUNTIME_DIR=/run/user/@UID@
Environment=PATH=/usr/local/go/bin:@HOME@/.deno/bin:@HOME@/.cargo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# Beim Boot nichts neu bauen (fertige Binaries), Preflight überspringen.
Environment=OMP_SKIP_BUILD=1
Environment=OMP_SKIP_PREFLIGHT=1
ExecStart=/bin/bash -c '[ -f deploy/dev/mxl.env ] && . deploy/dev/mxl.env; exec deploy/dev/start-omp.sh'
ExecStop=/bin/bash -c 'exec deploy/dev/stop-omp.sh'
KillMode=process
# Beim Kaltstart ist Postgres (Patroni) noch nicht bereit, der Orchestrator
# beendet sich dann — der nächste Versuch (make up ist idempotent) klappt.
Restart=on-failure
RestartSec=20
TimeoutStartSec=900
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
