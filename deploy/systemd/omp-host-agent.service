# systemd-Dienst für den OMP-Host-Agent (entfernter Host).
# Installation: ./install.sh --host-agent-service --orchestrator <IP>  (legt auch /etc/omp-host-agent.env an)
# Von Hand (als root), Platzhalter @…@ ersetzen:
#   sudo cp deploy/systemd/omp-host-agent.service /etc/systemd/system/
#   sudo install -m 600 /dev/null /etc/omp-host-agent.env   # und füllen, s. u.
#   sudo systemctl daemon-reload && sudo systemctl enable --now omp-host-agent
# /etc/omp-host-agent.env (Beispiel):
#   OMP_HOST_AGENT_LABEL=4001
#   OMP_ORCHESTRATOR_URL=http://192.168.0.60:8000
#   OMP_REGISTRY_URL=http://192.168.0.60:8010
#   OMP_NATS_URL=nats://192.168.0.60:4222,nats://192.168.0.60:4223,nats://192.168.0.60:4224
#   # nur beim allerersten Start (Registrierung): OMP_HOST_AGENT_BOOTSTRAP_TOKEN=...
# Hinweis: Beim Stoppen/Neustarten des Dienstes werden die vom Agent gestarteten Nodes mit beendet.
[Unit]
Description=OpenMediaPlatform Host-Agent
After=network-online.target
Wants=network-online.target

[Service]
# Uhr (Audit M1): Host-Agent/Orchestrator setzen TAI-Versatz und stellen die Uhr selbst, wenn kein Zeitdienst (chrony) läuft. Das braucht CAP_SYS_TIME.
# Bevorzugt nur für die Programmdatei: sudo setcap cap_sys_time+ep @ROOT@/bin/omp-host-agent  (nach jedem Neubau wiederholen). AmbientCapabilities=CAP_SYS_TIME
# würde auch an alle Nodes vererbt. Abschalten: OMP_CLOCK_DISCIPLINE=off; Server: OMP_CLOCK_NTP_SERVERS (Standard pool.ntp.org).
User=@USER@
# Härtung/Limits (Audit M11) — nur, was den Medienbetrieb und rootless Podman nicht berührt. Bewusst NICHT gesetzt: ProtectSystem/ProtectHome/PrivateTmp
# (Nodes schreiben unter @ROOT@ und /dev/shm/omp-mxl), ProtectControlGroups/RestrictSUIDSGID (rootless Podman), NoNewPrivileges (setcap für CAP_SYS_TIME).
ProtectKernelModules=yes
ProtectKernelLogs=yes
LockPersonality=yes
SystemCallArchitectures=native
LimitNOFILE=65536
LimitMEMLOCK=infinity
TasksMax=infinity
WorkingDirectory=@ROOT@
EnvironmentFile=/etc/omp-host-agent.env
ExecStart=/bin/bash -c '[ -f deploy/dev/mxl.env ] && . deploy/dev/mxl.env; exec ./bin/omp-host-agent'
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
