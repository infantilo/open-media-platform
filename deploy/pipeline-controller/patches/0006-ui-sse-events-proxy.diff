+// OMP-Microservice: proxy.rs kann `/events` nicht streamen (gepufferte
+// RawResponse, s. dortige Moduldoku) und antwortet bewusst mit 501 statt
+// den Adapter an einem nie endenden Body zu blockieren — ohne diesen
+// Parameter bliebe die eingebettete Oberfläche dadurch DAUERHAFT im
+// "OFFLINE"-Zustand (live per Browser gefunden, nicht nur per API/curl
+// getestet). Der Adapter liefert bei Bedarf einen echten, streamenden
+// zweiten Endpunkt über den Node-Parameter `eventsUrl`; steht dieser
+// Parameter nicht zur Verfügung (Standalone-PIPELINE-CONTROLLER, kein
+// OMP-Adapter davor), bleibt `_sseEventsBase` `null` und `_connectSSE`
+// nutzt weiterhin den bisherigen relativen `/events`-Pfad — unverändertes
+// Verhalten für alle Nicht-OMP-Deployments.
+let _sseEventsBase=null;
+async function _resolveSseEventsBase(){
+  try{
+    const r=await fetch('/params/eventsUrl');
+    if(!r.ok) return;
+    const d=await r.json();
+    if(typeof d?.value==='string' && /^https?:\/\//.test(d.value)) _sseEventsBase=d.value;
+  }catch{/* kein OMP-Adapter davor, oder Param unbekannt — Fallback bleibt relativ */}
+}
