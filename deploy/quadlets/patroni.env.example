# Kopieren nach /etc/omp/patroni.env (chmod 0600). Jedes "changeme" ersetzen, sonst startet die Unit nicht.
# Auf allen drei Hosts dieselben Werte, z. B. je  openssl rand -hex 24
PATRONI_SUPERUSER_PASSWORD=changeme
PATRONI_REPLICATION_PASSWORD=changeme
# Anmeldung für schreibende Aufrufe der Patroni-REST-API.
PATRONI_RESTAPI_USERNAME=patroni
PATRONI_RESTAPI_PASSWORD=changeme
# Passwort der Anwendungsrolle "omp" (gilt beim ersten Anlegen des Clusters; steht dann in OMP_POSTGRES_URL).
OMP_DB_PASSWORD=changeme
