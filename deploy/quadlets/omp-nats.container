[Unit]
Description=OpenMediaPlatform Event-Bus (NATS, Cluster-Knoten)
After=network-online.target

[Container]
Image=docker.io/library/nats:2.15.1@sha256:023a08c46caa5aff878fb86841187bebfdad9a6e3c552ba5c1a1e18938bbf88a
ContainerName=omp-nats
# NATS-Clustering (ARCHITECTURE.md §19.3 Punkt 7, UMSETZUNG.md D14): dieses Quadlet ist EIN Knoten eines
# Drei-Knoten-Clusters, je Host einmal. Nur mit Anmeldung und TLS: Konfiguration und Zertifikate liegen in
# /etc/omp/nats/ (omp-nats.conf, certs/), Geheimnisse und Adressen in /etc/omp/nats.env (0600).
# Vorlagen und Einrichtung: README.md in diesem Verzeichnis. Das Dev-Setup im Makefile ist davon unberührt.
EnvironmentFile=/etc/omp/nats.env
Volume=/etc/omp/nats:/etc/nats:ro,Z
Volume=omp-nats-data:/data
Exec=-c /etc/nats/omp-nats.conf
PublishPort=4222:4222
PublishPort=6222:6222
# Monitoring ohne Anmeldung, deshalb nur lokal.
PublishPort=127.0.0.1:8222:8222
# AutoUpdate bewusst aus: Image ist auf einen Digest gepinnt (deploy/images.env, Audit 2026-10-23); Updates über update-image-pins.sh

[Service]
# Start verweigern, solange Platzhalter in der Umgebungsdatei stehen.
ExecStartPre=/bin/sh -c 'test -r /etc/omp/nats.env && ! grep -v "^#" /etc/omp/nats.env | grep -q changeme'
Restart=always
TimeoutStartSec=30

[Install]
WantedBy=default.target
