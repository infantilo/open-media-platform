[Unit]
Description=OpenMediaPlatform Postgres-HA Koordination (etcd, ARCHITECTURE.md §19.3, UMSETZUNG.md D15)
After=network-online.target

[Container]
Image=quay.io/coreos/etcd:v3.5.35@sha256:60eea0773022eb2c38b73091e93d6784e0663212e6c4b98faf5547e99058e35d
ContainerName=omp-etcd
# etcd-Dreiknoten-Cluster als Patronis DCS (Distributed Configuration
# Store) — dieses Quadlet ist EIN Knoten, auf Bare-Metal/Produktion
# läuft es unveraendert auf drei getrennten Hosts, je einmal (gleiches
# Muster wie omp-nats.container, D14). ThisHost/EtcdHostB/EtcdHostC sind
# Platzhalter, vor dem Deployment durch die echten Hostnamen ersetzen.
# Standard-Ports 2379 (Client)/2380 (Peer) reichen hier, anders als das
# simulierte Ein-Maschine-Dev-Setup in Makefile postgres-up (das drei
# disjunkte Portsätze braucht, da alle drei Knoten dort denselben Host
# teilen).
# Client- und Peer-Port nur mit TLS und gültigem Zertifikat der CA in /etc/omp/etcd/ (ca.crt, server.crt,
# server.key). Diese CA nur für den Datenbank-Cluster verwenden: jedes Zertifikat von ihr hat vollen Zugriff.
# Einrichtung: README.md in diesem Verzeichnis.
Exec=etcd --name omp-etcd --data-dir /etcd-data \
  --initial-advertise-peer-urls https://ThisHost:2380 --listen-peer-urls https://0.0.0.0:2380 \
  --listen-client-urls https://0.0.0.0:2379 --advertise-client-urls https://ThisHost:2379 \
  --client-cert-auth --trusted-ca-file /certs/ca.crt --cert-file /certs/server.crt --key-file /certs/server.key \
  --peer-client-cert-auth --peer-trusted-ca-file /certs/ca.crt --peer-cert-file /certs/server.crt --peer-key-file /certs/server.key \
  --initial-cluster-token omp-etcd-cluster \
  --initial-cluster omp-etcd=https://ThisHost:2380,EtcdHostB=https://EtcdHostB:2380,EtcdHostC=https://EtcdHostC:2380 \
  --initial-cluster-state new
Volume=/etc/omp/etcd:/certs:ro,Z
Volume=omp-etcd-data:/etcd-data
PublishPort=2379:2379
PublishPort=2380:2380
# AutoUpdate bewusst aus: Image ist auf einen Digest gepinnt (deploy/images.env, Audit 2026-10-23); Updates über update-image-pins.sh

[Service]
Restart=always
TimeoutStartSec=30

[Install]
WantedBy=default.target
