# Kopieren nach /etc/omp/nats.env (chmod 0600). Jedes "changeme" ersetzen, sonst startet die Unit nicht.
# Passwörter: URL-sicher und mit einem Buchstaben beginnend, z. B.  printf 'p%s\n' "$(openssl rand -hex 24)"
NATS_SERVER_NAME=omp-nats-changeme
# Unter diesen Adressen erreichen Clients bzw. die anderen Server diesen Knoten.
NATS_CLIENT_ADVERTISE=ThisHost-changeme:4222
NATS_CLUSTER_ADVERTISE=ThisHost-changeme:6222
NATS_ORCHESTRATOR_PASSWORD=changeme
NATS_HOSTAGENT_PASSWORD=changeme
NATS_NODE_PASSWORD=changeme
NATS_ROUTE_PASSWORD=changeme
# Vollständige Route-Adressen der anderen beiden Knoten (Passwort = NATS_ROUTE_PASSWORD).
NATS_ROUTE_B=nats-route://route:changeme@ClusterHostB:6222
NATS_ROUTE_C=nats-route://route:changeme@ClusterHostC:6222
