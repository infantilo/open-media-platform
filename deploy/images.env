# Container-Images der Plattform — EINE Quelle für Makefile, Skripte und (per update-image-pins.sh) Quadlets/CI.
# Jedes Image steht als `registry/repo:tag@sha256:<Digest>`: das Tag bleibt lesbar, der Digest macht den Bezug unveränderlich
# (Audit 2026-10-23, niedrig: ein bewegtes Tag kann still ein anderes Image liefern; z. B. postgres:16-alpine hat sich seit dem
# letzten lokalen Pull geändert). Datei ist zugleich gültige sh- und make-Syntax (nur NAME=Wert, keine Leerzeichen).
#
# Aktualisieren: ./deploy/dev/update-image-pins.sh            (Tags unverändert, Digests neu aus der Registry)
#                ./deploy/dev/update-image-pins.sh --check     (nur prüfen, Exit 1 bei Abweichung)
# Neue Version: Tag HIER ändern, dann update-image-pins.sh ausführen.
#
# Offline-Installationen (Images per `podman load`, der Digest bleibt dabei nicht erhalten) setzen .run/images-unpinned
# (macht deploy/offline/install-offline.sh); dann gilt nur das Tag.
NATS_IMAGE=docker.io/library/nats:2.15.1@sha256:023a08c46caa5aff878fb86841187bebfdad9a6e3c552ba5c1a1e18938bbf88a
NMOS_REGISTRY_IMAGE=docker.io/rhastie/nmos-cpp:master-b6c8367@sha256:68e61e17dffab70303cfc10fcf4f5f8f219ae84eb189961e120e86a126959413
ETCD_IMAGE=quay.io/coreos/etcd:v3.5.35@sha256:60eea0773022eb2c38b73091e93d6784e0663212e6c4b98faf5547e99058e35d
CADDY_IMAGE=docker.io/library/caddy:2.11.7@sha256:504a44d7d74bd2bc28a66afc4774912fc21223ca8a67734af1c54ab2f999b489
STEP_CA_IMAGE=docker.io/smallstep/step-ca:0.30.2@sha256:a2b17872915c193259b75a5474c398326f41bd199f0842093e52cf4182bc8270
SEAWEEDFS_IMAGE=docker.io/chrislusf/seaweedfs:4.48@sha256:4e61d15fd35994cb1e43e1e553dff106794841fd9a99ade2fc8c8bfce4d7872d
POSTGRES_IMAGE=docker.io/library/postgres:16-alpine@sha256:f4610795587492cd4fb887c2dc3de301b813278bb6f616992061141b5f15ac36
NMOS_TESTING_IMAGE=docker.io/amwa/nmos-testing:latest@sha256:1a75a923f5afc632252aa9173295ad534194a1a13b6323cfc39bf4c5f295f8b4
